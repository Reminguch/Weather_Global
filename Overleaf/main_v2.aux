\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \leavevmode {\color  {blue}Ten-day forecasts from 00\,UTC on 15 January 2022 at the $1^\circ $ grid points nearest Paris ($49^\circ $N, $2^\circ $E; left) and New York City ($41^\circ $N, $74^\circ $W; right). Rows show $2$\,m temperature, $850$\,hPa zonal wind (U850), and $6$\,h accumulated precipitation in physical units. ERA5 is black, GraphCast is dashed orange, and the GraphCast--Mamba forecast is blue. The correction is the separately trained $K=20$ model in Figure\nobreakspace  {}\ref  {fig:pervar_k20_15yr}, fitted to 15 years of ERA5 data. Both forecasts use ERA5 states at $-6$ and $0$\,h, then feed back their own predictions; the GraphCast--Mamba model begins with a zero temporal memory state. The dotted line marks initialization. Precipitation is shown as predicted and may take small negative values.}\relax }}{17}{figure.caption.23}\protected@file@percent }
\newlabel{fig:city_traces_jan}{{9}{17}{\textcolor {blue}{Ten-day forecasts from 00\,UTC on 15 January 2022 at the $1^\circ $ grid points nearest Paris ($49^\circ $N, $2^\circ $E; left) and New York City ($41^\circ $N, $74^\circ $W; right). Rows show $2$\,m temperature, $850$\,hPa zonal wind (U850), and $6$\,h accumulated precipitation in physical units. ERA5 is black, GraphCast is dashed orange, and the GraphCast--Mamba forecast is blue. The correction is the separately trained $K=20$ model in Figure~\ref {fig:pervar_k20_15yr}, fitted to 15 years of ERA5 data. Both forecasts use ERA5 states at $-6$ and $0$\,h, then feed back their own predictions; the GraphCast--Mamba model begins with a zero temporal memory state. The dotted line marks initialization. Precipitation is shown as predicted and may take small negative values.}\relax }{figure.caption.23}{}}
