\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces GraphCast--Mamba architecture. A frozen GraphCast forecast $G_\theta (X_t)$ is combined with the forecast correction $c_t$ to produce $\hat  {Y}_t$. The correction branch has separate parameters and a temporal memory state $m_t$, comprising the SSM states and causal-convolution caches of its four Mamba layers.\relax }}{3}{figure.caption.1}\protected@file@percent }
\newlabel{fig:GC_Mamba}{{1}{3}{GraphCast--Mamba architecture. A frozen GraphCast forecast $G_\theta (X_t)$ is combined with the forecast correction $c_t$ to produce $\hat {Y}_t$. The correction branch has separate parameters and a temporal memory state $m_t$, comprising the SSM states and causal-convolution caches of its four Mamba layers.\relax }{figure.caption.1}{}}
