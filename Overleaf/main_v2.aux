\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Temporal memory improves forecasts at longer lead times. All three policies use the same architecture with $d_{\mathrm  {inner}}=16$, one $B,C$ group, and SWA over updates 2k--8k. Carry/carry retains state during training and forecasting; carry/reset clears state during forecasting; reset/reset clears it during both. Carry/carry achieves the largest day-10 loss reduction. Results use 32 matched cold-start forecast initializations and 40 six-hour forecast steps; positive values indicate lower loss than the paired GraphCast baseline. Loss is reconstructed approximately from saved channel RMSEs.\relax }}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:memory_reset}{{5}{10}{Temporal memory improves forecasts at longer lead times. All three policies use the same architecture with $d_{\mathrm {inner}}=16$, one $B,C$ group, and SWA over updates 2k--8k. Carry/carry retains state during training and forecasting; carry/reset clears state during forecasting; reset/reset clears it during both. Carry/carry achieves the largest day-10 loss reduction. Results use 32 matched cold-start forecast initializations and 40 six-hour forecast steps; positive values indicate lower loss than the paired GraphCast baseline. Loss is reconstructed approximately from saved channel RMSEs.\relax }{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Inner dimension and Mamba learning-rate comparison at $1^\circ $ on the matched 32-initialization development evaluation. Entries are exact GraphCast loss reductions (\%); bold marks the largest value in each metric column. All runs use spatial width 512, one $B,C$ group, batch size four, the same training schedule, and SWA over post-warm-up updates 500, 1,000, 1,500, and 2,000. The spatial learning rate is unchanged; $1\times $ denotes equal spatial and Mamba learning rates.\relax }}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:res1_skill}{{1}{10}{Inner dimension and Mamba learning-rate comparison at $1^\circ $ on the matched 32-initialization development evaluation. Entries are exact GraphCast loss reductions (\%); bold marks the largest value in each metric column. All runs use spatial width 512, one $B,C$ group, batch size four, the same training schedule, and SWA over post-warm-up updates 500, 1,000, 1,500, and 2,000. The spatial learning rate is unchanged; $1\times $ denotes equal spatial and Mamba learning rates.\relax }{table.caption.9}{}}
