\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Forecast skill of the $d_{\mathrm  {inner}}=16$ correction trained with a threefold Mamba learning rate (LR) and stochastic weight averaging (SWA) at $1^\circ $ on 32 matched forecast initializations. Top: exact GraphCast loss and per-lead loss reduction. Bottom: cosine-latitude-weighted $2$\,m temperature RMSE (K) and RMSE reduction on the same forecast initializations. Reductions are relative to its paired GraphCast baseline. Training and model-selection details are given in Appendix\nobreakspace  {}\ref  {app:training}.\relax }}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:res1_forecast}{{2}{7}{Forecast skill of the $d_{\mathrm {inner}}=16$ correction trained with a threefold Mamba learning rate (LR) and stochastic weight averaging (SWA) at $1^\circ $ on 32 matched forecast initializations. Top: exact GraphCast loss and per-lead loss reduction. Bottom: cosine-latitude-weighted $2$\,m temperature RMSE (K) and RMSE reduction on the same forecast initializations. Reductions are relative to its paired GraphCast baseline. Training and model-selection details are given in Appendix~\ref {app:training}.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \leavevmode {\color  {blue}Variable-group RMSE reduction relative to frozen GraphCast at forecast leads of 120--240\,h. Each cell reports $100\,(1-\mathrm  {RMSE}_{\mathrm  {ours}}/\mathrm  {RMSE}_{\mathrm  {GraphCast}})$, with positive values indicating lower error for the GraphCast--Mamba forecast. RMSE is computed in each variable's physical units, using cosine-latitude weighting and averaging squared errors across forecast initializations before taking the square root. For upper-air variables, squared errors are also averaged equally across the 13 pressure levels. This correction was trained separately on 15 years of ERA5 data (2007--2021), with a training tail of $K=20$ feedback-conditioned steps, Mamba inner dimension $128$, spatial width $512$, and two graph message-passing steps; SWA averages checkpoints from updates 6k--11k. Evaluation comprises 32 forecast initializations in 2022, drawn from 30 January--11 February, 26 May--7 June, and 20 September--2 October. The temporal memory state is initialized to zero, and each GraphCast--Mamba prediction is fed back in full for the next step. These initialization dates differ from the matched set used in Figure\nobreakspace  {}\ref  {fig:res1_forecast}.}\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pervar_k20_15yr}{{3}{8}{\textcolor {blue}{Variable-group RMSE reduction relative to frozen GraphCast at forecast leads of 120--240\,h. Each cell reports $100\,(1-\mathrm {RMSE}_{\mathrm {ours}}/\mathrm {RMSE}_{\mathrm {GraphCast}})$, with positive values indicating lower error for the GraphCast--Mamba forecast. RMSE is computed in each variable's physical units, using cosine-latitude weighting and averaging squared errors across forecast initializations before taking the square root. For upper-air variables, squared errors are also averaged equally across the 13 pressure levels. This correction was trained separately on 15 years of ERA5 data (2007--2021), with a training tail of $K=20$ feedback-conditioned steps, Mamba inner dimension $128$, spatial width $512$, and two graph message-passing steps; SWA averages checkpoints from updates 6k--11k. Evaluation comprises 32 forecast initializations in 2022, drawn from 30 January--11 February, 26 May--7 June, and 20 September--2 October. The temporal memory state is initialized to zero, and each GraphCast--Mamba prediction is fed back in full for the next step. These initialization dates differ from the matched set used in Figure~\ref {fig:res1_forecast}.}\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Complete common-grid comparison. The quantities span geopotential, temperature, mean sea-level pressure, specific humidity, and wind. The panel labels use Z for geopotential, T for temperature, Q for specific humidity, U for zonal wind, and V for meridional wind; a three-digit suffix gives pressure in hPa. T2m denotes $2$\,m temperature, U10 and V10 denote the $10$\,m wind components, and MSL denotes mean sea-level pressure. Blue is the archived $K=22$ GraphCast--Mamba configuration, dashed gray its GraphCast baseline, and green GraphCast ($0.25^\circ $). Forecasts are verified on a common $1.5^\circ $ grid, with RMSE normalized to the ECMWF ensemble (ENS) reference ($100\%$ denotes equal RMSE). This historical comparison is separate from the evaluations on matched forecast initializations in Figure\nobreakspace  {}\ref  {fig:res1_forecast}.\relax }}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:res1_all_variables}{{4}{9}{Complete common-grid comparison. The quantities span geopotential, temperature, mean sea-level pressure, specific humidity, and wind. The panel labels use Z for geopotential, T for temperature, Q for specific humidity, U for zonal wind, and V for meridional wind; a three-digit suffix gives pressure in hPa. T2m denotes $2$\,m temperature, U10 and V10 denote the $10$\,m wind components, and MSL denotes mean sea-level pressure. Blue is the archived $K=22$ GraphCast--Mamba configuration, dashed gray its GraphCast baseline, and green GraphCast ($0.25^\circ $). Forecasts are verified on a common $1.5^\circ $ grid, with RMSE normalized to the ECMWF ensemble (ENS) reference ($100\%$ denotes equal RMSE). This historical comparison is separate from the evaluations on matched forecast initializations in Figure~\ref {fig:res1_forecast}.\relax }{figure.caption.7}{}}
